CMakeUserPresets.json
Testing/

# SpaceX trajectory files of a snapshot: large, and the site states no redistribution
# terms. metadata.json in the snapshot records their checksums.
data/starlink/*/ephemerides/
data/starlink/.*.partial/

# Working directory of an interrupted ground-data download.
data/ground/.*.partial/

# LENS ping files (python/fetch_lens.py): share-alike licence, so not redistributed here.
# metadata.json in each date directory records their URLs and checksums.
data/lens/*/*
!data/lens/*/metadata.json

# Outputs of python/run_phase2.py (about 1 GB of CSV); the committed summaries are in
# docs/phase-2-data/.
results/
