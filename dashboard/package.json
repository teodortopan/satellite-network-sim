{
  "name": "satsim-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Phase 5 dashboard: replays the satellite network simulator's saved runs in the browser.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "three": "0.187.0",
    "topojson-client": "3.1.0",
    "uplot": "1.6.32",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
